# Neon PostgreSQL — gunakan pooled endpoint untuk runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Base URL deployment (tanpa trailing slash)
BASE_URL=https:

# Resend
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=AYAKA API <noreply@your-verified-domain.com>
ADMIN_EMAIL=olpieditz336@gmail.com

# Secrets — generate dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
API_KEY_PEPPER=
SESSION_SECRET=

# Environment
ENVIRONMENT=production